# Environment Variables

# Base URL for the application (used in sitemap and metadata)
# Default: https://country-rank.bastiendmt.vercel.app
NEXT_PUBLIC_BASE_URL=https://country-rank.bastiendmt.vercel.app

# API URL for REST Countries API
# Default: https://api.restcountries.com/countries/v5
RESTCOUNTRIES_API_URL=https://api.restcountries.com/countries/v5

# API key for REST Countries API (required, server-only, never prefix with NEXT_PUBLIC_)
RESTCOUNTRIES_API_KEY=
